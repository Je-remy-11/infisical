-    SAVED_HASH="$(cat "$STATE_FILE")"
-  fi
-  if [ "$CURRENT_HASH" != "$SAVED_HASH" ]; then
-    SHOULD_INSTALL=1
-  fi
-fi
-
-if [ "$SHOULD_INSTALL" = "1" ]; then
-  mkdir -p node_modules
-  echo "Installing dependencies in $APP_DIR..."
-  sh -lc "$INSTALL_COMMAND"
