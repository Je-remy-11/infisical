diff --git a/order-system/src/test/java/com/example/ordersystem/order/OrderTimeoutServiceTest.java b/order-system/src/test/java/com/example/ordersystem/order/OrderTimeoutServiceTest.java
new file mode 100644
index 0000000000..aa3155c97e
