# =============================================================================
# Infisical Development Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed for your local setup.
# All ports use environment variable substitution with sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Port Mappings (Host:Container)
# -----------------------------------------------------------------------------
# Core Services
NGINX_PORT=8080
DB_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=4000
FRONTEND_PORT=5173
BACKEND_GO_PORT=8082

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Debug & Monitoring
BACKEND_OTEL_PORT=9464
BACKEND_DEBUG_PORT=9229

# Utility Services
REDIS_COMMANDER_PORT=8085
BULL_BOARD_PORT=3008
PGADMIN_PORT=5050
DB_TEST_PORT=5430

# SMTP / MailHog
SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# LDAP (Profile: ldap)
LDAP_PORT=389
LDAPS_PORT=636
PHPLDAPADMIN_PORT=6433

# SSO (Profile: sso)
KEYCLOAK_PORT=8088

# PingFederate (Profile: pingfed)
PINGFED_ADMIN_PORT=9999
PINGFED_RUNTIME_PORT=9031

# Samba AD (Profile: ad)
SAMBALDAP_PORT=1389
SAMBALDAPS_PORT=1636
SAMBA_KERBEROS_PORT=88

# Metrics (Profile: metrics)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3005

# OpenTelemetry (Profile: metrics-otel)
OTEL_PPROF_PORT=1888
OTEL_PROMETHEUS_PORT=8888
OTEL_PROMETHEUS_EXPORT_PORT=8889
OTEL_HEALTH_PORT=13133
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_ZPAGES_PORT=55679

# -----------------------------------------------------------------------------
# Required Keys & Secrets
# -----------------------------------------------------------------------------
# Key for platform encryption/decryption ops
ENCRYPTION_KEY=f13dbc92aaaf86fa7cb0ed8ac3265f47

# Secret to sign JWT tokens
AUTH_SECRET=5lrMXKKWCVocS/uerPsl7V+TX/aaUaI7iDkgl3tSmLE=

# Postgres credentials
POSTGRES_PASSWORD=infisical
POSTGRES_USER=infisical
POSTGRES_DB=infisical

# Database connection URI (uses above credentials)
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis connection URL
REDIS_URL=redis://redis:6379

# Website URL (must match NGINX_PORT)
SITE_URL=http://localhost:${NGINX_PORT:-8080}

# -----------------------------------------------------------------------------
# Mail/SMTP Configuration
# -----------------------------------------------------------------------------
SMTP_HOST=smtp-server
SMTP_PORT=1025
SMTP_FROM_ADDRESS=test@infisical.com
SMTP_FROM_NAME=Infisical Dev
SMTP_USERNAME=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Optional Integration Credentials
