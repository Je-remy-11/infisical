# =============================================================================
# Infisical Development Environment Configuration
# =============================================================================
# Port Mappings (docker-compose.dev.yml):
#   Backend API:        4000  -> 4000  (main API server)
#   Backend Debug:      9229  -> 9229  (Node.js inspector / debugger)
#   Backend OTEL:       9464  -> 9464  (Prometheus metrics)
#   Frontend (Vite):    3000  -> 3000  (Vite dev server with HMR)
#   Backend-Go:         4040  -> 4040  (Go sidecar, requires --profile go)
#   Nginx:              8080  -> 80    (reverse proxy to frontend + backend)
#   PostgreSQL:         5432  -> 5432
#   Redis:              6379  -> 6379
#   Redis Commander:    8085  -> 8081
#   ClickHouse HTTP:    8123  -> 8123
#   ClickHouse Native:  9000  -> 9000
#   SMTP (MailHog):     1025  -> 1025
#   MailHog Web UI:     8025  -> 8025
#   Bull Board:         3008  -> 3000  (queue monitoring, --profile queue)
#   pgAdmin:            5050  -> 80
#   Prometheus:         9090  -> 9090  (--profile metrics)
#   Grafana:            3005  -> 3000  (--profile metrics)
#   OpenLDAP:           389   -> 389   (--profile ldap)
#   phpLDAPadmin:       6433  -> 80    (--profile ldap)
#   Keycloak:           8088  -> 8080  (--profile sso)
#   PingFederate Admin: 9999  -> 9999  (--profile pingfed)
#   PingFederate OIDC:  9031  -> 9031  (--profile pingfed)
#   Samba AD LDAP:      1389  -> 389   (--profile ad)
#   Samba AD LDAPS:     1636  -> 636   (--profile ad)
#   Samba AD Kerberos:  88    -> 88    (--profile ad)
#
# For hot-reload, the following technologies are used:
#   Backend:    nodemon watches src/ for .ts/.js changes
#   Frontend:   Vite HMR watches src/ via WebSocket on port 3000
#   Backend-Go: Air watches for .go/.toml changes (--profile go)
# =============================================================================

# Keys
# Required key for platform encryption/decryption ops
# THIS IS A SAMPLE ENCRYPTION KEY AND SHOULD NEVER BE USED FOR PRODUCTION
ENCRYPTION_KEY=VVHnGZ0w98WLgISK4XSJcagezuG6EWRFTk48KE4Y5Mw=

# JWT
# Required secrets to sign JWT tokens
# THIS IS A SAMPLE AUTH_SECRET KEY AND SHOULD NEVER BE USED FOR PRODUCTION
AUTH_SECRET=5lrMXKKWCVocS/uerPsl7V+TX/aaUaI7iDkgl3tSmLE=

# Postgres creds
POSTGRES_PASSWORD=infisical
POSTGRES_USER=infisical
POSTGRES_DB=infisical

# Required
DB_CONNECTION_URI=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Redis
REDIS_URL=redis://redis:6379

# Website URL
# Required
SITE_URL=http://localhost:8080

# Mail/SMTP

SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_FROM_ADDRESS=dev@infisical.local
SMTP_FROM_NAME=Infisical
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=

# Integration
# Optional only if integration is used
CLIENT_ID_HEROKU=
CLIENT_ID_VERCEL=
CLIENT_ID_NETLIFY=
CLIENT_ID_GITHUB=
CLIENT_ID_GITHUB_APP=
CLIENT_SLUG_GITHUB_APP=
CLIENT_ID_GITLAB=
CLIENT_ID_BITBUCKET=
CLIENT_SECRET_HEROKU=
CLIENT_SECRET_VERCEL=
CLIENT_SECRET_NETLIFY=
CLIENT_SECRET_GITHUB=
CLIENT_SECRET_GITHUB_APP=
CLIENT_SECRET_GITLAB=
CLIENT_SECRET_BITBUCKET=
CLIENT_SLUG_VERCEL=

CLIENT_PRIVATE_KEY_GITHUB_APP=
CLIENT_APP_ID_GITHUB_APP=

# Sentry (optional) for monitoring errors
SENTRY_DSN=

# Infisical Cloud-specific configs
# Ignore - Not applicable for self-hosted version
POSTHOG_HOST=
POSTHOG_PROJECT_API_KEY=

# SSO-specific variables
CLIENT_ID_GOOGLE_LOGIN=
CLIENT_SECRET_GOOGLE_LOGIN=

CLIENT_ID_GITHUB_LOGIN=
CLIENT_SECRET_GITHUB_LOGIN=

CLIENT_ID_GITLAB_LOGIN=
CLIENT_SECRET_GITLAB_LOGIN=

CAPTCHA_SECRET=

NEXT_PUBLIC_CAPTCHA_SITE_KEY=

OTEL_TELEMETRY_COLLECTION_ENABLED=false
OTEL_EXPORT_TYPE=prometheus
OTEL_EXPORT_OTLP_ENDPOINT=
OTEL_OTLP_PUSH_INTERVAL=

OTEL_COLLECTOR_BASIC_AUTH_USERNAME=
OTEL_COLLECTOR_BASIC_AUTH_PASSWORD=
OTEL_DROP_HIGH_CARDINALITY_METERS=false

PLAIN_API_KEY=
PLAIN_WISH_LABEL_IDS=

SSL_CLIENT_CERTIFICATE_HEADER_KEY=

ENABLE_MSSQL_SECRET_ROTATION_ENCRYPT=true

