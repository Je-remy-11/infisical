# ========== Development Environment Port Configuration ==========
# These ports are used in docker-compose.dev.yml and can be customized
# If you change these, make sure the ports are available on your system

# Main Services
NGINX_PORT=8080                    # Main web interface (via Nginx)
BACKEND_PORT=4000                  # Backend API
FRONTEND_PORT=3000                 # Frontend Vite dev server

# Database
DB_PORT=5432                       # Postgres database
DB_TEST_PORT=5430                  # Test database

# Redis & Tools
REDIS_PORT=6379                    # Redis cache
REDIS_COMMANDER_PORT=8085          # Redis web UI
BULL_BOARD_PORT=3008               # Bull queue dashboard

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123          # ClickHouse HTTP interface
CLICKHOUSE_TCP_PORT=9000           # ClickHouse TCP interface

# Observability
PROMETHEUS_PORT=9090               # Prometheus metrics
GRAFANA_PORT=3005                  # Grafana dashboard

# OTEL Collector
OTEL_PORT=9464                     # OTEL Prometheus endpoint
OTEL_PPROF_PORT=1888               # OTEL pprof
OTEL_METRICS_PORT=8888             # OTEL Prometheus metrics
OTEL_EXPORTER_PORT=8889            # OTEL exporter
OTEL_HEALTH_PORT=13133             # OTEL health check
OTEL_GRPC_PORT=4317                # OTEL gRPC
OTEL_HTTP_PORT=4318                # OTEL HTTP
OTEL_ZPAGES_PORT=55679             # OTEL zpages

# Backend Go
BACKEND_GO_PORT=4040               # Go backend API

# Debugging
BACKEND_DEBUG_PORT=9229            # Node.js debugger

# Database Tools
PGADMIN_PORT=5050                  # pgAdmin web UI

# Email Testing
SMTP_PORT=1025                     # MailHog SMTP server
SMTP_WEB_PORT=8025                 # MailHog web UI

# LDAP / Active Directory
LDAP_PORT=389                      # OpenLDAP
LDAPS_PORT=636                     # OpenLDAPS (LDAP over TLS)
PHPLDAPADMIN_PORT=6433             # phpLDAPadmin web UI
SAMBA_LDAP_PORT=1389               # Samba AD LDAP
SAMBA_LDAPS_PORT=1636              # Samba AD LDAPS
SAMBA_KERBEROS_PORT=88             # Samba AD Kerberos
SAMBA_KERBEROS_UDP_PORT=88         # Samba AD Kerberos UDP

# SSO / Identity Providers
KEYCLOAK_PORT=8088                 # Keycloak
PINGFEDERATE_ADMIN_PORT=9999       # PingFederate admin console
PINGFEDERATE_RUNTIME_PORT=9031     # PingFederate runtime

# Vite Configuration for Hot Module Replacement (HMR)
# These settings help with frontend hot-reload in Docker
VITE_ALLOWED_HOSTS=*
CHOKIDAR_USEPOLLING=true
